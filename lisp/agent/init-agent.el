;;; init-agent.el --- Wiring for agent support -*- lexical-binding: t; -*-

;;; Commentary:

;; Agent CLIs run in the background over a structured protocol; Emacs renders the
;; conversation (agent-session).
;; Session buffer (modeled on telega): the conversation on top, the input area after
;; the separator and prompt; model and other info in the mode line.
;; Global commands live under the C-c a prefix:
;;   C-c a a  show / hide the agent column  C-c a n  new session (C-u: pick agent)
;;   C-c a i  message the project's session  C-c a s  session list (live + history)
;;   C-c a f  input with current file ref    C-c a r  input with region code block
;;   C-c a k  end session                    C-c a v  back to agent's last page
;; In a session buffer: RET sends from the input area, C-j inserts a newline,
;; M-p / M-n history, TAB completes (/ commands, @ files);
;; C-c C-k clears input or interrupts, C-c C-o settings menu, C-c C-y / C-c C-n
;; allow / deny;
;; while the agent runs: RET queues, M-RET steers (sent into the current turn at
;; once), C-c C-g turns the oldest queued message into a steer;
;; typing in the transcript jumps to the input area.
;;
;; Adding an agent: implement a backend (see agent-claude.el), then add one
;; `agent-session-define-agent' line.

;;; Code:

(use-package agent-session
  :demand t
  :config
  (keymap-global-set "C-c a" agent-session-command-map)
  (with-eval-after-load 'project
    (add-to-list 'project-switch-commands '(agent-session-create "Agent" ?a) t)))

(use-package agent-claude
  :after agent-session
  :demand t
  :config
  (agent-session-define-agent claude :title "Claude"))

(use-package agent-codex
  :after agent-session
  :demand t
  :config
  (agent-session-define-agent codex :title "Codex"))

(use-package agent-session-list
  :after agent-session
  :demand t)

;; agent → Emacs: the methods called by the emx command and MCP server are
;; all defined in agent-ui.
(use-package agent-ui
  :demand t
  :after agent-session
  :config
  (keymap-set agent-session-command-map "v" #'agent-ui-last-view))

;; Native pages generated by agents: the render / patch methods.
(use-package agent-canvas
  :demand t
  :after agent-ui)

;; Atomic reviews of a branch: the review_* methods and the review buffer.
(use-package agent-review
  :demand t
  :after agent-canvas)

;; Session handles (@name) and the sessions / session_read / session_ask methods
;; agents use to work with each other.
(use-package agent-collab
  :demand t
  :after agent-ui)

(defmacro agent-session--evil-enter (name command)
  "Define NAME to run evil's COMMAND in the input area.
Elsewhere it jumps to the end of the input area and enters insert state.
The macro is defined at top level so it is available at compile time; the
generated commands are only used once evil is loaded."
  `(defun ,name ()
     ,(format "Like `%s' in the input area.
In the transcript, jump to the end of the input area and enter insert state." command)
     (interactive)
     (if (agent-session--in-input-p)
         (call-interactively #',command)
       (goto-char (point-max))
       (evil-insert-state))))

;; evil is not loaded by default (see `my/use-evil'); declare the functions used
;; here so compilation does not warn.
(declare-function evil-insert "evil-commands")
(declare-function evil-append "evil-commands")
(declare-function evil-insert-line "evil-commands")
(declare-function evil-append-line "evil-commands")
(declare-function evil-open-below "evil-commands")
(declare-function evil-open-above "evil-commands")
(declare-function evil-insert-state "evil-states")
(declare-function evil-exit-visual-state "evil-states")
(declare-function evil-set-initial-state "evil-core")
(declare-function evil-define-key* "evil-core")

;; These commands only touch evil when called, so defining them early is harmless.
(agent-session--evil-enter agent-session-evil-insert evil-insert)
(agent-session--evil-enter agent-session-evil-append evil-append)
(agent-session--evil-enter agent-session-evil-insert-line evil-insert-line)
(agent-session--evil-enter agent-session-evil-append-line evil-append-line)
(agent-session--evil-enter agent-session-evil-open-below evil-open-below)
(agent-session--evil-enter agent-session-evil-open-above evil-open-above)

(defun agent-review-evil-annotate (start end)
  "Annotate the lines of the visual selection from START to END.
In visual state a is the text object prefix, so this rebinds it there."
  (interactive "r")
  (evil-exit-visual-state)
  (agent-review-annotate start end))

;; Vim keys (when evil is loaded).  Session buffers start in normal state: i / a / o
;; etc. keep their meaning in the input area, and in the transcript jump to the end
;; of the input area and enter insert state; in insert state RET sends, and ESC
;; returns to normal state to browse the conversation.  Settings and approvals live
;; under the local leader "," (only active in agent buffers).
(with-eval-after-load 'evil
  (evil-define-key* '(normal motion visual) 'global
    (kbd "<leader>a") agent-session-command-map)

  (defvar-keymap agent-session-local-leader-map
    :doc "Keys after , in session buffers."
    "o" #'agent-session-menu
    "m" #'agent-session-select-model
    "e" #'agent-session-select-effort
    "M" #'agent-session-select-mode
    "p" #'agent-session-toggle-plan
    "A" #'agent-session-select-agent
    "y" #'agent-session-approve
    "n" #'agent-session-deny
    "k" #'agent-session-interrupt
    "g" #'agent-session-steer-queued
    "x" #'agent-session-cancel-queued
    "s" #'agent-session-list
    "N" #'agent-session-new
    "r" #'agent-session-resume)

  (evil-set-initial-state 'agent-session-mode 'normal)
  (evil-define-key* '(normal motion) agent-session-mode-map
    (kbd "RET") #'agent-session-ret
    "i" #'agent-session-evil-insert
    "a" #'agent-session-evil-append
    "I" #'agent-session-evil-insert-line
    "A" #'agent-session-evil-append-line
    "o" #'agent-session-evil-open-below
    "O" #'agent-session-evil-open-above
    "]]" #'agent-session-next-message
    "[[" #'agent-session-previous-message
    (kbd "TAB") #'forward-button
    (kbd "<backtab>") #'backward-button
    "q" #'quit-window
    "," agent-session-local-leader-map)

  (evil-set-initial-state 'agent-session-list-mode 'normal)
  (evil-define-key* '(normal motion) agent-session-list-mode-map
    (kbd "RET") #'agent-session-list-open
    "o" #'agent-session-list-open
    "c" #'agent-session-list-create
    "x" #'agent-session-list-kill
    "gr" #'agent-session-list-refresh
    "]]" #'agent-session-list-next
    "[[" #'agent-session-list-previous
    "q" #'quit-window)

  (evil-set-initial-state 'agent-canvas-mode 'normal)
  (evil-define-key* '(normal motion) agent-canvas-mode-map
    (kbd "RET") #'push-button
    (kbd "TAB") #'agent-canvas-tab
    (kbd "<backtab>") #'backward-button
    "c" #'agent-canvas-comment
    "gr" #'revert-buffer
    "q" #'quit-window)

  (evil-set-initial-state 'agent-review-mode 'normal)
  (evil-define-key* '(normal motion) agent-review-mode-map
    (kbd "RET") #'agent-review-visit
    (kbd "TAB") #'agent-review-toggle
    "]]" #'agent-review-next-item
    "[[" #'agent-review-previous-item
    "]c" #'agent-review-next-annotation
    "[c" #'agent-review-previous-annotation
    "a" #'agent-review-annotate
    "dd" #'agent-review-delete-annotation
    "r" #'agent-review-toggle-reviewed
    "o" #'agent-review-toggle-nav
    "C" #'agent-review-list-annotations
    "f" #'agent-review-toggle-full
    "+" #'agent-review-more-context
    "-" #'agent-review-less-context
    "{" #'agent-review-expand-up
    "}" #'agent-review-expand-down
    "gr" #'revert-buffer
    "q" #'quit-window)
  (evil-define-key* 'visual agent-review-mode-map
    "a" #'agent-review-evil-annotate)

  (evil-set-initial-state 'agent-review-nav-mode 'normal)
  (evil-define-key* '(normal motion) agent-review-nav-mode-map
    (kbd "RET") #'agent-review-nav-visit
    "r" #'agent-review-nav-toggle-reviewed
    "/" #'agent-review-nav-filter
    "gr" #'revert-buffer
    "q" #'quit-window)

  (evil-set-initial-state 'agent-review-notes-mode 'normal)
  (evil-define-key* '(normal motion) agent-review-notes-mode-map
    (kbd "RET") #'agent-review-notes-visit
    "gr" #'revert-buffer
    "q" #'quit-window)

  (evil-set-initial-state 'agent-review-note-mode 'insert))

;; Agents call back into this instance through emacsclient / emx.
(use-package server
  :demand t
  :config
  (unless (or noninteractive (daemonp) (server-running-p))
    (server-start)))

(provide 'init-agent)
;;; init-agent.el ends here
