;;; agent-codex-instructions-test.el --- Codex environment tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'agent-codex)

(ert-deftest agent-codex-instructions-preserve-user-text ()
  (let* ((original "  Keep my rules.\n\nDo not trim me.\n")
         (result (agent-codex--developer-instructions
                  "/project/" (list :config (list :developer_instructions original)))))
    (should (string-prefix-p (concat original "\n\n") result))
    (should (string-match-p "first discover and call the emacs MCP context tool" result))
    (should (string-match-p "Unless the user explicitly refers to another application" result))
    (should-not (string-match-p "project host" result))))

(ert-deftest agent-codex-instructions-no-user-text ()
  (dolist (config '((:developer_instructions nil) (:model "test")))
    (let ((text (agent-codex--developer-instructions "/project/" (list :config config))))
      (should (string-prefix-p "This session is hosted" text)))))

(ert-deftest agent-codex-instructions-remote-boundary ()
  (let ((text (agent-codex--developer-instructions
               "/ssh:example:/project/" '(:config (:developer_instructions "User rules")))))
    (should (string-prefix-p "User rules\n\n" text))
    (should (string-match-p "The agent shell runs on the project host" text))
    (should (string-match-p "config_read/config_edit/config_write, then reload" text))))

(ert-deftest agent-codex-instructions-invalid-config ()
  (dolist (result '(nil (:config "bad") (:config nil)
                       (:config (:developer_instructions 42))))
    (should-error (agent-codex--developer-instructions "/project/" result))))

(ert-deftest agent-codex-instructions-start-and-resume ()
  "Read config on the same transport before either thread operation."
  (dolist (root '("/project/" "/ssh:example:/project/"))
    (dolist (resume '(nil "saved-thread"))
      (let* ((session (agent-session--make :root root :settings '(:model "test-model")))
             (writes nil)
             (notices nil))
        (when resume (agent-codex--set session :resume resume))
        (cl-letf (((symbol-function 'agent-session-write)
                   (lambda (s message)
                     (should (eq s session))
                     (push message writes)))
                  ((symbol-function 'agent-session-notice)
                   (lambda (&rest args) (push args notices))))
          (agent-codex--start-thread session)
          (should (= (length writes) 1))
          (let* ((request (car writes))
                 (id (plist-get request :id))
                 (cwd (plist-get (plist-get request :params) :cwd)))
            (should (equal (plist-get request :method) "config/read"))
            (should (equal cwd "/project/"))
            (agent-session-backend-handle
             'codex session
             (list :id id :result '(:config (:developer_instructions "Existing"))))
            (should-not (gethash id (agent-codex--state session :callbacks)))
            (should-not (gethash id (agent-codex--state session :error-callbacks)))
            (should (= (length writes) 2))
            (let* ((thread-request (car writes))
                   (params (plist-get thread-request :params)))
              (should (equal (plist-get thread-request :method)
                             (if resume "thread/resume" "thread/start")))
              (should (equal (plist-get params :cwd) cwd))
              (should (equal (plist-get params :model) "test-model"))
              (should (equal (plist-get params :threadId) resume))
              (should (eq (plist-get params :excludeTurns) (and resume t)))
              (should (string-prefix-p
                       "Existing\n\n" (plist-get params :developerInstructions)))))
          (should-not notices))))))

(ert-deftest agent-codex-instructions-read-failure ()
  "RPC errors and malformed responses retain the server's user instructions."
  (dolist (resume '(nil "saved-thread"))
    (dolist (reply '((:error (:code -32601 :message "Unsupported config/read"))
                     (:result (:config (:developer_instructions 42)))))
      (let ((session (agent-session--make :root "/project/"))
            (writes nil)
            (notices nil))
        (when resume (agent-codex--set session :resume resume))
        (cl-letf (((symbol-function 'agent-session-write)
                   (lambda (_ message) (push message writes)))
                  ((symbol-function 'agent-session-notice)
                   (lambda (_ text &rest _) (push text notices))))
          (agent-codex--start-thread session)
          (let ((id (plist-get (car writes) :id)))
            (agent-session-backend-handle 'codex session (append (list :id id) reply))
            (should-not (gethash id (agent-codex--state session :callbacks)))
            (should-not (gethash id (agent-codex--state session :error-callbacks))))
          (should (= (length writes) 2))
          (should (equal (plist-get (car writes) :method)
                         (if resume "thread/resume" "thread/start")))
          (should-not (plist-member (plist-get (car writes) :params)
                                    :developerInstructions))
          (should (= (length notices) 1)))))))

(ert-deftest agent-codex-instructions-default-rpc-error ()
  "Requests without an error callback still report errors and release callbacks."
  (let ((session (agent-session--make))
        (called nil)
        (request nil)
        (notices nil))
    (cl-letf (((symbol-function 'agent-session-write)
               (lambda (_ message) (setq request message)))
              ((symbol-function 'agent-session-notice)
               (lambda (_ text &rest _) (push text notices))))
      (agent-codex--request session "example" nil (lambda (_) (setq called t)))
      (let ((id (plist-get request :id)))
        (agent-session-backend-handle
         'codex session (list :id id :error '(:message "Failure")))
        (should-not (gethash id (agent-codex--state session :callbacks))))
      (should-not called)
      (should (= (length notices) 1)))))

(provide 'agent-codex-instructions-test)
;;; agent-codex-instructions-test.el ends here
