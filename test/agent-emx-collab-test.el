;;; agent-emx-collab-test.el --- Daemon child view tests -*- lexical-binding: t; -*-
(require 'test-helper
         (expand-file-name "test-helper.el"
                           (file-name-directory (or load-file-name buffer-file-name))))
(require 'ert)
(require 'agent-emx)
(require 'agent-collab)
(require 'agent-emx-test)

(ert-deftest agent-emx-collab-adopts-child-without-opening-another-cli ()
  (agent-emx-test--with-session
    (let* ((connection (agent-emx--make-connection))
           (parent session)
           (agent-session-last-settings nil)
           attached child)
      (puthash "parent" parent (agent-emx--connection-sessions connection))
      (agent-session-tool parent "start" :kind 'mcp :status 'running :title "emacs · session_start")
      (cl-letf (((symbol-function 'agent-emx--attach)
                 (lambda (session peer)
                   (should (eq peer connection))
                   (setq attached session)))
                ((symbol-function 'agent-session-refresh-programs)
                 (lambda (_) (ert-fail "Adopting a view must not probe its host"))))
        (setq child
              (agent-emx--adopt
               connection '(:id "child" :agent "dsh" :root "/private/tmp/"
                             :info (:parent "parent" :handle "bounded" :profile "coder-flash"
                                             :named t :title "子任务")))))
      (unwind-protect
          (progn
            (should (eq child attached))
            (should (eq (agent-session-backend child) 'emx))
            (should (eq (agent-session-parent child) parent))
            (should (eq (gethash "child" (agent-emx--connection-sessions connection)) child))
            (should (equal (agent-session-handle child) "bounded"))
            (should (eq (plist-get (agent-session--block parent "start") :subagent)
                        (agent-session-buffer child)))
            (should (eq child (agent-emx--adopt connection '(:id "child"))))
            (agent-emx--ask child '(:id "ask" :type "approval" :choices ["allow" "deny"]
                                       :view (:kind "command" :name "bash" :title "echo")))
            (should (agent-session--pending-asks parent))
            (let ((answer nil))
              (cl-letf (((symbol-function 'agent-emx--rpc)
                         (lambda (target method params &optional _callback)
                           (setq answer (list target method params)))))
                (let* ((copy (agent-session--ask parent
                                                 (car (agent-session--pending-asks parent))))
                       (callback (plist-get copy :callback)))
                  (funcall callback 'allow)))
              (should (eq (car answer) child))
              (should (equal (cadr answer) "session/answer")))
            (agent-emx--close-view connection "child")
            (should-not (buffer-live-p (agent-session-buffer child)))
            (should-not (agent-session--pending-asks parent)))
        (when (buffer-live-p (agent-session-buffer child))
          (agent-emx--close-view connection "child"))))))

(ert-deftest agent-emx-collab-origin-and-hidden-note-are-not-user-text ()
  (agent-emx-test--with-session
    (agent-emx--block session '(:id "mail" :type "user" :text "Reply from child"
                                   :origin "@bounded"))
    (should (equal (plist-get (agent-session--block session "mail") :origin) "@bounded"))
    (should-not (memq 'agent-collab--name-on-submit
                      agent-session-submit-functions))))
(provide 'agent-emx-collab-test)

(ert-deftest agent-emx-collab-reconnect-reattaches-existing-child-once ()
  (agent-emx-test--with-session
    (let ((connection (agent-emx--make-connection)) calls)
      (puthash "s" session (agent-emx--connection-sessions connection))
      (agent-session-set-status session 'disconnected)
      (cl-letf (((symbol-function 'agent-emx--attach)
                 (lambda (target peer) (push (cons target peer) calls))))
        (dotimes (_ 2)
          (should (eq session (agent-emx--adopt connection '(:id "s"))))))
      (should (= (length calls) 1))
      (should (eq (caar calls) session)))))

(ert-deftest agent-emx-collab-fresh-editor-recovers-roots-children-and-native-id ()
  (let* ((agent-emx-var-directory (agent-emx-test--var-directory "emx-recover-"))
         (agent-emx--connections (make-hash-table :test #'equal))
         (agent-session-skills nil)
         (agent-session-last-settings nil)
         (agent-session-status-functions nil)
         (agent-session--list-refresh-function nil)
         (agent-session--clock nil)
         (root (file-name-as-directory agent-emx-var-directory))
         connection parent-id child-id done recovered)
    (unwind-protect
        (progn
          (agent-emx--local-connection (lambda (c) (setq connection c))
                                       (lambda (e) (ert-fail e)))
          (agent-emx-test--wait (lambda () connection))
          (agent-emx--request connection "session/open"
                              (list :agent "echo" :root root :resume "native-recover"
                                    :settings '(:mode "ask") :handle "recovered-parent")
                              (lambda (r) (setq parent-id (plist-get r :id))))
          (agent-emx-test--wait (lambda () parent-id))
          (agent-emx--request connection "session/open"
                              (list :agent "echo" :root root :parent parent-id
                                    :handle "recovered-child")
                              (lambda (r) (setq child-id (plist-get r :id))))
          (agent-emx-test--wait (lambda () child-id))
          (dolist (id (list parent-id child-id))
            (agent-emx--request connection "session/send" (list :id id :text "ask recovery")))
          (agent-emx--request connection "sessions/list" nil (lambda (_) (setq done t)))
          (agent-emx-test--wait (lambda () done))
          ;; Lose all editor state without sending session/stop, like process death.
          (delete-process (agent-emx--connection-process connection))
          (maphash (lambda (_ s)
                     (with-current-buffer (agent-session-buffer s)
                       (setq kill-buffer-hook nil))
                     (kill-buffer (agent-session-buffer s)))
                   (agent-emx--connection-sessions connection))
          (setq agent-emx--connections (make-hash-table :test #'equal)
                connection nil)
          (agent-emx--local-connection (lambda (c) (setq connection c))
                                       (lambda (e) (ert-fail e)))
          (agent-emx-test--wait (lambda () connection))
          (agent-emx-test--wait
           (lambda () (setq recovered (gethash parent-id (agent-emx--connection-sessions connection)))))
          (agent-emx-test--wait
           (lambda () (and (= 1 (length (agent-session-children recovered)))
                           (agent-session--pending-asks recovered))))
          (should (equal (agent-session-handle recovered) "recovered-parent"))
          (should (equal (agent-session-setting recovered :mode) 'ask))
          (should (string-match-p "ask recovery" (agent-emx-test--transcript recovered)))
          (should (agent-session--pending-asks (car (agent-session-children recovered))))
          (should (memq (agent-session-buffer recovered) (agent-session-buffers root)))
          (should (eq (agent-session-open 'echo root "native-recover")
                      (agent-session-buffer recovered)))
          ;; A resume request reuses the same daemon session, even without a view.
          (setq done nil)
          (agent-emx--request connection "session/open"
                              (list :agent "echo" :root root :resume "native-recover")
                              (lambda (r) (setq done r)))
          (agent-emx-test--wait (lambda () done))
          (should (equal (plist-get done :id) parent-id))
          (setq done nil)
          (agent-emx--request connection "sessions/list" nil (lambda (r) (setq done r)))
          (agent-emx-test--wait (lambda () done))
          (should (= (length (plist-get done :sessions)) 2)))
      (when connection
        (dolist (s (hash-table-values (agent-emx--connection-sessions connection)))
          (when (buffer-live-p (agent-session-buffer s))
            (agent-session-kill-quietly (agent-session-buffer s))))
        (when (process-live-p (agent-emx--connection-process connection))
          (delete-process (agent-emx--connection-process connection))))
      (call-process "node" nil nil nil (expand-file-name "bin/emx" agent-emx--checkout)
                    "daemon" "--var" agent-emx-var-directory "--stop")
      (when (timerp agent-session--clock) (cancel-timer agent-session--clock))
      (delete-directory agent-emx-var-directory t))))

(ert-deftest agent-emx-collab-drops-hub-replies-after-source-reconnect ()
  (dolist (outcome '(success failure))
    (dolist (reconnect '(nil t))
      (let* ((source (agent-emx--make-connection :process 'original))
             (target (agent-emx--make-connection))
             success failure replies)
        (cl-letf (((symbol-function 'agent-emx--hub-connections)
                   (lambda (&optional _) (list target)))
                  ((symbol-function 'agent-emx--request)
                   (lambda (_connection _method _params ok fail)
                     (setq success ok failure fail)))
                  ((symbol-function 'agent-emx--write)
                   (lambda (connection message)
                     (push (list (agent-emx--connection-process connection) message) replies))))
          ;; Enter through the daemon's public editor request dispatcher.
          (agent-emx--editor-call
           source (list :jsonrpc "2.0" :id 1 :method "editor/call"
                        :params (list :method "_collab_deliver"
                                      :params (list :route (list :daemon (agent-emx--route-id target))))))
          ;; The matching route is computed by the production routing code.
          (unless success (ert-fail "Hub request was not dispatched"))
          (when reconnect (setf (agent-emx--connection-process source) 'replacement))
          (if (eq outcome 'success) (funcall success '(:delivered t))
            (funcall failure '(:message "late failure")))
          (should (= (length replies) (if reconnect 0 1))))))))

(ert-deftest agent-emx-collab-lost-open-reuses-pending-view-and-backend ()
  (dolist (retry-first '(nil t))
    (let* ((agent-emx-var-directory (agent-emx-test--var-directory "emx-lost-open-"))
           (agent-emx--connections (make-hash-table :test #'equal))
           (agent-session-skills nil) (agent-session-last-settings nil)
           (agent-session-status-functions nil) (agent-session--list-refresh-function nil)
           (agent-session--clock nil)
           (root (file-name-as-directory agent-emx-var-directory))
           (request (symbol-function 'agent-emx--request))
           connection session buffer lost summaries creation-ids)
      (unwind-protect
          (progn
            (agent-emx--local-connection (lambda (c) (setq connection c))
                                       (lambda (e) (ert-fail e)))
            (agent-emx-test--wait (lambda () connection))
            (cl-letf (((symbol-function 'agent-emx--request)
                       (lambda (c method params &optional success failure)
                         (if (equal method "session/open")
                             (progn
                               (push (plist-get params :creationId) creation-ids)
                               (funcall request c method params
                                        (lambda (result)
                                          (if lost (funcall success result)
                                            (setq lost t)
                                            (funcall failure '(:connection-lost t :message "lost reply"))))
                                        failure))
                           (funcall request c method params success failure)))))
              (setq buffer (agent-session-open 'test-emx root)
                    session (buffer-local-value 'agent-session--current buffer))
              (agent-emx-test--wait (lambda () lost))
              (when retry-first
                ;; An uncertain open retry must reuse its original creation id.
                (agent-session-backend-reconnect 'emx session)
                (agent-emx-test--wait (lambda () (agent-emx--get session :emx-id))))
              ;; Reconnect through the real transport and hello recovery path.
              ;; With no retry yet, this view has never learned its daemon id.
              (delete-process (agent-emx--connection-process connection))
              (agent-emx-test--wait (lambda () (not (agent-emx--connection-ready connection))))
              (agent-session-backend-reconnect 'emx session)
              (agent-emx-test--wait
               (lambda () (and (agent-emx--connection-ready connection)
                               (agent-emx--get session :emx-id)
                               (not (agent-emx--get session :emx-attaching))
                               (eq (agent-session-status session) 'idle))))
              (should (car creation-ids))
              (should (= (length creation-ids) (if retry-first 2 1)))
              (when retry-first (should (equal (car creation-ids) (cadr creation-ids)))))
            (agent-emx--request connection "sessions/list" nil (lambda (r) (setq summaries r)))
            (agent-emx-test--wait (lambda () summaries))
            (should (= (length (plist-get summaries :sessions)) 1))
            (should (eq session (gethash (plist-get (aref (plist-get summaries :sessions) 0) :id)
                                        (agent-emx--connection-sessions connection))))
            (should (= (length (agent-session-buffers root)) 1))
            (agent-session-backend-reconnect 'emx session))
        (dolist (view (agent-session-buffers root)) (agent-session-kill-quietly view))
        (when (and connection (process-live-p (agent-emx--connection-process connection)))
          (delete-process (agent-emx--connection-process connection)))
        (call-process "node" nil nil nil (expand-file-name "bin/emx" agent-emx--checkout)
                      "daemon" "--var" agent-emx-var-directory "--stop")
        (when (timerp agent-session--clock) (cancel-timer agent-session--clock))
        (delete-directory agent-emx-var-directory t)))))

(ert-deftest agent-emx-collab-closed-lost-open-is-cancelled-before-recovery ()
  (let* ((agent-emx-var-directory (agent-emx-test--var-directory "emx-cancel-open-"))
         (agent-emx--connections (make-hash-table :test #'equal))
         (agent-session-skills nil) (agent-session-last-settings nil)
         (agent-session-status-functions nil) (agent-session--list-refresh-function nil)
         (agent-session--clock nil)
         (root (file-name-as-directory agent-emx-var-directory))
         (request (symbol-function 'agent-emx--request))
         connection session buffer lost creation summaries)
    (unwind-protect
        (progn
          (agent-emx--local-connection (lambda (c) (setq connection c))
                                     (lambda (e) (ert-fail e)))
          (agent-emx-test--wait (lambda () connection))
          (cl-letf (((symbol-function 'agent-emx--request)
                     (lambda (c method params &optional success failure)
                       (if (equal method "session/open")
                           (progn
                             (setq creation (plist-get params :creationId))
                             (funcall request c method params
                                      (lambda (_)
                                        (setq lost t)
                                        (funcall failure '(:connection-lost t :message "lost reply")))
                                      failure))
                         (funcall request c method params success failure)))))
            (setq buffer (agent-session-open 'test-emx root)
                  session (buffer-local-value 'agent-session--current buffer))
            (agent-emx-test--wait (lambda () lost)))
          (should-not (agent-emx--get session :emx-id))
          (delete-process (agent-emx--connection-process connection))
          (agent-emx-test--wait (lambda () (not (agent-emx--connection-ready connection))))
          (agent-session-kill-quietly buffer)
          (should (member creation (agent-emx--connection-pending-cancellations connection)))
          (let (reconnected)
            (agent-emx--local-connection (lambda (_) (setq reconnected t))
                                       (lambda (e) (ert-fail e)))
            (agent-emx-test--wait (lambda () reconnected)))
          (should-not (agent-emx--connection-pending-cancellations connection))
          (agent-emx--request connection "sessions/list" nil (lambda (r) (setq summaries r)))
          (agent-emx-test--wait (lambda () summaries))
          (should (= 0 (length (plist-get summaries :sessions))))
          (should-not (agent-session-buffers root))
          (should (= 0 (hash-table-count (agent-emx--connection-sessions connection)))))
      (dolist (view (agent-session-buffers root)) (agent-session-kill-quietly view))
      (when (and connection (process-live-p (agent-emx--connection-process connection)))
        (delete-process (agent-emx--connection-process connection)))
      (call-process "node" nil nil nil (expand-file-name "bin/emx" agent-emx--checkout)
                    "daemon" "--var" agent-emx-var-directory "--stop")
      (when (timerp agent-session--clock) (cancel-timer agent-session--clock))
      (delete-directory agent-emx-var-directory t))))

(ert-deftest agent-emx-collab-recovery-canonicalizes-creation-and-daemon-ids ()
  (dolist (duplicate-id '(nil t))
    (let* ((agent-emx-var-directory (agent-emx-test--var-directory "emx-duplicate-"))
           (agent-emx--connections (make-hash-table :test #'equal))
           (agent-session-skills nil) (agent-session-last-settings nil)
           (agent-session-status-functions nil) (agent-session--list-refresh-function nil)
           (agent-session--clock nil)
           (root (file-name-as-directory agent-emx-var-directory))
           connection session buffer duplicate summaries)
      (unwind-protect
          (progn
            (setq buffer (agent-session-open 'test-emx root)
                  session (buffer-local-value 'agent-session--current buffer))
            (agent-emx-test--wait (lambda () (eq (agent-session-status session) 'idle)))
            (setq connection (agent-emx--get session :emx-connection))
            ;; Reproduce two already-existing views without opening a second CLI.
            (setq duplicate (agent-session--make
                             :agent 'test-emx :backend 'emx :root root
                             :buffer (generate-new-buffer " *duplicate-emx*")
                             :status 'disconnected
                             :client (list :emx-connection connection
                                           :emx-creation-id (agent-emx--get session :emx-creation-id)
                                           :emx-id (and duplicate-id (agent-emx--get session :emx-id)))))
            (agent-session--setup-buffer duplicate)
            (delete-process (agent-emx--connection-process connection))
            (agent-emx-test--wait (lambda () (not (agent-emx--connection-ready connection))))
            (agent-session-backend-reconnect 'emx session)
            (agent-emx-test--wait
             (lambda () (and (agent-emx--connection-ready connection)
                             (eq (agent-session-status session) 'idle)
                             (not (buffer-live-p (agent-session-buffer duplicate))))))
            (should (eq session (gethash (agent-emx--get session :emx-id)
                                        (agent-emx--connection-sessions connection))))
            (should (= 1 (length (agent-session-buffers root))))
            (agent-session-backend-send 'emx session "canonical routing")
            (agent-emx-test--wait
             (lambda () (string-match-p "echo: canonical routing"
                                        (agent-emx-test--transcript session))))
            (agent-emx--request connection "sessions/list" nil (lambda (r) (setq summaries r)))
            (agent-emx-test--wait (lambda () summaries))
            (should (= 1 (length (plist-get summaries :sessions)))))
        (dolist (view (agent-session-buffers root)) (agent-session-kill-quietly view))
        (when (and duplicate (buffer-live-p (agent-session-buffer duplicate)))
          (agent-session-kill-quietly (agent-session-buffer duplicate)))
        (when (and connection (process-live-p (agent-emx--connection-process connection)))
          (delete-process (agent-emx--connection-process connection)))
        (call-process "node" nil nil nil (expand-file-name "bin/emx" agent-emx--checkout)
                      "daemon" "--var" agent-emx-var-directory "--stop")
        (when (timerp agent-session--clock) (cancel-timer agent-session--clock))
        (delete-directory agent-emx-var-directory t)))))
