;;; agent-emx-remote-test.el --- Simulated host transport -*- lexical-binding: t; -*-

;;; Code:
(require 'ert)
(require 'agent-emx-test)

(defvar agent-emx-remote-test--home nil)
(defvar agent-emx-remote-test--executable "fake-agent")
(defconst agent-emx-remote-test--prefix "/rpc:phase7:")

(defun agent-emx-remote-test--path (value)
  "Map simulated host file VALUE without contacting tramp."
  (if (and (stringp value) (string-prefix-p agent-emx-remote-test--prefix value))
      (let ((local (substring value (length agent-emx-remote-test--prefix))))
        (cond ((string-prefix-p "~/" local)
               (expand-file-name (substring local 2) agent-emx-remote-test--home))
              ((and agent-emx-remote-test--home
                    (string-prefix-p agent-emx-remote-test--home local)) local)
              (t (concat agent-emx-remote-test--home local))))
    value))

(defun agent-emx-remote-test--handler (operation &rest args)
  "Perform file OPERATION with ARGS in the simulated host directory."
  (if (and (eq operation 'expand-file-name)
           (string-prefix-p (concat agent-emx-remote-test--prefix "~/") (car args)))
      (concat agent-emx-remote-test--prefix (agent-emx-remote-test--path (car args)))
   (if (eq operation 'file-remote-p)
      (pcase (nth 1 args)
        ('host "phase7") ('localname (substring (car args) (length agent-emx-remote-test--prefix)))
        (_ agent-emx-remote-test--prefix))
    (let ((file-name-handler-alist nil))
      (apply operation
             (if (memq operation '(file-name-as-directory directory-file-name
							  file-name-directory file-name-nondirectory expand-file-name))
                 args
               (mapcar #'agent-emx-remote-test--path args)))))))

(defun agent-emx-remote-test--wait (predicate)
  "Wait at most ten seconds for PREDICATE."
  (let ((deadline (+ (float-time) 10)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.02))
    (should (funcall predicate))))

(ert-deftest agent-emx-remote-node-and-single-lookup ()
  (dolist (version '("v18.17.0" "v18.20.8" "v20.3.0" "v22.18.0" "v26.9.0"))
    (should (agent-emx-remote--node-p version)))
  (dolist (version '(nil "v18.16.9" "v19.9.0" "v20.2.9" "v16.20.2" "missing" "18.17.0"))
    (should-not (agent-emx-remote--node-p version)))
  (let ((agent-session--remote-programs (make-hash-table :test #'equal))
        (agent-session-agents '((test . (:executable agent-emx-remote-test--executable))))
        calls)
    (cl-letf (((symbol-function 'process-file)
               (lambda (_program _input _buffer _display &rest args)
                 (push args calls)
                 (should-not (string-match-p "node --version" (nth 1 args)))
                 (insert "1\n") 0)))
      (agent-session-check-programs "/rpc:phase7:/project/")
      (should (= (length calls) 1))
      (let ((known (gethash "/rpc:phase7:/project/" agent-session--remote-programs)))
        (should-not (plist-get known :node))
        (should (equal (plist-get known :programs) '(("fake-agent" . t))))))))

(ert-deftest agent-emx-remote-install-is-content-addressed-and-complete ()
  (let* ((agent-emx-remote-test--home (make-temp-file "emx-install-" t))
         (file-name-handler-alist (cons '("\\`/rpc:phase7:" . agent-emx-remote-test--handler)
					file-name-handler-alist))
         (manifest (agent-emx-remote--manifest))
         (root "/rpc:phase7:/project/")
         (copy (symbol-function 'copy-file))
         (count 0))
    (unwind-protect
        (cl-letf (((symbol-function 'copy-file)
                   (lambda (&rest args)
                     (when (string-prefix-p agent-emx-remote-test--prefix (nth 1 args))
                       (cl-incf count))
                     (apply copy args))))
          (agent-emx-remote--install root manifest)
          (should (= count (length (plist-get manifest :files))))
          (let* ((dir (expand-file-name (concat ".cache/emacs-agent/emx/"
                                                (plist-get manifest :version) ".current")
					agent-emx-remote-test--home))
                 (marker (expand-file-name ".complete" (file-truename dir))))
            (should (file-exists-p (expand-file-name "lisp/agent/backend/dsh/emacs-bridge.mjs" dir)))
            (should-not (file-exists-p (expand-file-name "emx/node_modules" dir)))
            (agent-emx-remote--install root manifest)
            (should (= count (length (plist-get manifest :files))))
            ;; A bad/incomplete marker forces a complete retry.
            (with-temp-file marker (insert "old-version"))
            (let ((fresh (agent-emx-remote--install root manifest)))
              (should (equal (with-temp-buffer
                               (insert-file-contents (concat fresh ".complete"))
                               (buffer-string)) (plist-get manifest :version)))
              (should (equal (with-temp-buffer (insert-file-contents marker)
                                                (buffer-string)) "old-version")))
            (should (= count (* 2 (length (plist-get manifest :files)))))))
      (delete-directory agent-emx-remote-test--home t))))

(ert-deftest agent-emx-remote-forward-reuses-only-the-current-master ()
  (let ((root "/rpc:phase7:/project/") (master "1") calls first second)
    (cl-letf (((symbol-function 'agent-remote--master)
               (lambda (_) (list "/tmp/stub-master" "phase7" master)))
              ((symbol-function 'agent-remote--ssh)
               (lambda (_control _host &rest args)
                 (push args calls)
                 (when (equal (nth 1 args) "forward")
                   (with-temp-file (car (split-string (nth 3 args) ":")) (insert "stub")))
                 '(0 . ""))))
      (unwind-protect
          (progn
            (setq first (agent-emx-remote--forward root "/host/emx.sock" nil))
            (should (equal (nth 2 (car calls)) "-L"))
            (should (= (file-modes (plist-get first :dir)) #o700))
            (should (eq first (agent-emx-remote--forward root "/host/emx.sock" first)))
            (should (= (length calls) 1))
            (setq master "2" second (agent-emx-remote--forward root "/host/emx.sock" first))
            (should-not (equal (plist-get first :socket) (plist-get second :socket)))
            (should-not (file-exists-p (plist-get first :dir)))
            (should (equal (plist-get second :master) "2")))
        (agent-emx-remote--close-forward second)))))

(ert-deftest agent-emx-remote-timer-never-opens-a-host ()
  (agent-emx-test--with-session
   (let* ((agent-emx--connections (make-hash-table :test #'equal))
          (connection (agent-emx--make-connection :place "/rpc:phase7:/project/"))
          (connected nil) (attempts 0))
     (setf (agent-session-status session) 'disconnected)
     (puthash "s" session (agent-emx--connection-sessions connection))
     (puthash "remote" connection agent-emx--connections)
     (cl-letf (((symbol-function 'agent-session--host-connected-p) (lambda (_) connected))
               ((symbol-function 'agent-emx--ready)
                (lambda (_) (should agent-emx-remote--automatic) (cl-incf attempts)))
               ((symbol-function 'agent-remote--master) (lambda (_) (ert-fail "Opened a host"))))
       (agent-emx-remote--reconnect)
       (should (= attempts 0))
       (setq connected t)
       (agent-emx-remote--reconnect)
       (should (= attempts 1))))))

(ert-deftest agent-emx-remote-paths-and-editor-context ()
  (agent-emx-test--with-session
   (let ((connection (agent-emx--make-connection :place "/rpc:phase7:/project/")) caller reply)
     (setf (agent-session-root session) "/rpc:phase7:/project/")
     (puthash "s" session (agent-emx--connection-sessions connection))
     (cl-letf (((symbol-function 'agent-ui-call)
                (lambda (_method _params context)
                  (setq caller context)
                  '(:ok t :result (:file "/rpc:phase7:/project/a.el"))))
               ((symbol-function 'agent-emx--write) (lambda (_ result) (setq reply result))))
       (agent-emx--editor-call connection
                               '(:id 1 :method "editor/call" :params
                                     (:method "open" :params (:path "/project/a.el")
					      :caller (:session "s" :root "/project/"))))
       (should (equal (plist-get caller :root) "/rpc:phase7:/project/"))
       (should (equal (plist-get (plist-get (plist-get reply :result) :result) :file)
                      "/project/a.el"))
       (should (equal (agent-emx-remote-path connection "/project/a.el")
                      "/rpc:phase7:/project/a.el"))))))

(ert-deftest agent-emx-remote-config-push-preserves-json-types ()
  (let ((agent-emx--connections (make-hash-table :test #'equal))
        (agent-emx-config--value nil) (agent-emx-config--wire nil) sent)
    (let ((connection (agent-emx--make-connection :place "/rpc:phase7:/project/" :ready t))
          (local (agent-emx--make-connection)))
      (puthash "host" connection agent-emx--connections)
      (cl-letf (((symbol-function 'agent-emx--request)
                 (lambda (_ method params &rest _) (setq sent (cons method params)))))
        (agent-emx--filter local (encode-coding-string
                                  "{\"method\":\"config\",\"params\":{\"config\":{\"profiles\":{},\"collab\":{\"agentHandleCommands\":{},\"confirm\":false}}}}\n"
                                  'utf-8 t))
        (should (equal (car sent) "config/push"))
        (should (equal (json-serialize (plist-get (cdr sent) :config)
                                       :null-object :null :false-object :false)
                       "{\"profiles\":{},\"collab\":{\"agentHandleCommands\":{},\"confirm\":false}}"))))))

(ert-deftest agent-emx-remote-ensure-rejects-version-before-forwarding ()
  (let ((connection (agent-emx--make-connection :place "/rpc:phase7:/project/")) failure)
    (cl-letf (((symbol-function 'agent-emx-remote--manifest)
               (lambda () '(:version "expected" :files [])))
              ((symbol-function 'agent-emx-remote--process)
               (lambda (_root _command buffer)
                 (with-current-buffer buffer
                   (insert "{\"socket\":\"/tmp/stub.sock\",\"version\":\"wrong\"}\n"))
                 0))
              ((symbol-function 'agent-emx-remote--forward)
               (lambda (&rest _) (ert-fail "Forwarded mismatched installed code")))
              ((symbol-function 'agent-emx--lost)
               (lambda (_connection error &rest _) (setq failure error))))
      (agent-emx-remote--ensure connection)
      (agent-emx-remote-test--wait (lambda () failure))
      (should (string-match-p "version does not match" (plist-get failure :message))))))

(ert-deftest agent-emx-remote-automatic-ensure-rechecks-connectivity ()
  (let ((connection (agent-emx--make-connection :place "/rpc:phase7:/project/"))
        (agent-emx-remote--automatic t) failure)
    (cl-letf (((symbol-function 'agent-emx-remote--manifest)
               (lambda () '(:version "expected" :files [])))
              ((symbol-function 'agent-session--host-connected-p) (lambda (_) nil))
              ((symbol-function 'agent-emx-remote--process)
               (lambda (&rest _) (ert-fail "Opened a disconnected host")))
              ((symbol-function 'agent-emx--lost)
               (lambda (_connection error &rest _) (setq failure error))))
      (agent-emx-remote--ensure connection)
      (should (string-match-p "No remembered host socket" (plist-get failure :message))))))

(ert-deftest agent-emx-remote-command-targets-the-current-host ()
  (agent-emx-test--with-session
   (setf (agent-session-root session) "/rpc:phase7:/project/")
   (let (target)
     (cl-letf (((symbol-function 'agent-emx-remote-connection)
                (lambda (root _callback _error) (setq target root)))
               ((symbol-function 'agent-emx--local-connection)
                (lambda (&rest _) (setq target 'local))))
       (agent-emx--daemon-connection #'ignore #'ignore)
       (should (equal target "/rpc:phase7:/project/"))
       (agent-emx--daemon-connection #'ignore #'ignore (agent-emx--make-connection))
       (should (eq target 'local))))))

(ert-deftest agent-emx-remote-master-inspection-does-not-touch-root ()
  (cl-letf (((symbol-function 'agent-session--host-connected-p) (lambda (_) t))
            ((symbol-function 'file-directory-p) (lambda (_) (ert-fail "Touched remote root")))
            ((symbol-function 'tramp-rpc--controlmaster-socket-path) (lambda (_) "/tmp/stub-master"))
            ((symbol-function 'agent-remote--ssh) (lambda (&rest _) '(0 . "Master running (pid=42)"))))
    (should (equal (agent-remote--master "/rpc:phase7:/project/" t)
                   '("/tmp/stub-master" "phase7" "42")))))

(ert-deftest agent-emx-remote-usage-acks-only-after-local-receipt ()
  (let ((agent-emx-remote--inflight (make-hash-table :test #'eq))
        (remote (agent-emx--make-connection :place "/rpc:phase7:/project/" :ready t))
        (local (agent-emx--make-connection)) callbacks sent)
    (cl-letf (((symbol-function 'agent-emx--local-connection)
               (lambda (callback _error &rest _) (funcall callback local)))
              ((symbol-function 'agent-emx--request)
               (lambda (connection method params &optional callback _error)
                 (push (list connection method params) sent)
                 (when callback (push callback callbacks)))))
      (let ((entry [(:id "receipt" :source "host-producer" :sequence 7 :method "record" :params
			 (:record (:agent "codex" :root "/project/" :input 2)))]))
        (agent-emx-remote-usage remote entry)
        (should (= (length sent) 1))
        (should (equal (cadar sent) "usage/record"))
        (should (equal (plist-get (plist-get (nth 2 (car sent)) :record) :root)
                       "/rpc:phase7:/project/"))
        ;; A repeated delivery while the local request is pending is coalesced.
        (agent-emx-remote-usage remote entry)
        (should (= (length sent) 1))
        (setf (agent-emx--connection-ready remote) nil)
        (funcall (pop callbacks) '(:id "receipt" :source "host-producer" :sequence 7))
        (should (= (length sent) 1))
        (setf (agent-emx--connection-ready remote) t)
        (agent-emx-remote-usage remote entry)
        (should (= (length sent) 2))
        (should (equal (plist-get (nth 2 (car sent)) :id) "receipt"))
        (funcall (pop callbacks) '(:id "receipt" :source "host-producer" :sequence 7))
        (should (equal (cadar sent) "usage/ack"))
        (should (equal (nth 2 (car sent)) '(:source "host-producer" :sequence 7)))))))

(ert-deftest agent-emx-remote-simulated-host-round-trip ()
  "Run the real ensure command locally, replacing only tramp and ssh."
  (let* ((agent-emx-remote-test--home (make-temp-file "/tmp/emx-host-" t))
         (agent-emx-var-directory (agent-emx-test--var-directory "emx-local-"))
         (agent-emx--connections (make-hash-table :test #'equal))
         (agent-session--remote-programs (make-hash-table :test #'equal))
         (agent-emx-remote--inflight (make-hash-table :test #'eq))
         (agent-emx-remote--timer nil)
         (agent-emx-config--value nil) (agent-emx-config--wire nil)
         (agent-session-skills nil)
         (agent-usage--monitoring nil)
         (file-name-handler-alist (cons '("\\`/rpc:phase7:" . agent-emx-remote-test--handler)
					file-name-handler-alist))
         (root "/rpc:phase7:/project/")
         (master "1") (ensures 0) (forwards 0) remote local local-view)
    (puthash root '(:node "v26.9.0") agent-session--remote-programs)
    (cl-letf (((symbol-function 'agent-emx-remote--process)
               (lambda (_root command buffer)
                 (cl-incf ensures)
                 (let ((default-directory agent-emx--checkout)
                       (process-environment (cons (concat "HOME=" agent-emx-remote-test--home)
                                                  process-environment)))
                   (apply #'call-process (car command) nil buffer nil (cdr command)))))
              ((symbol-function 'agent-emx-remote--forward)
               (lambda (_root socket _old &optional _connected-only)
                 (cl-incf forwards) (list :socket socket :master master))))
      (unwind-protect
          (agent-emx-test--with-session
           (setf (agent-session-root session) root)
           (agent-emx--set session :emx-id nil)
           (agent-emx--set session :emx-epoch nil)
           (agent-emx--ready session)
           (agent-emx-remote-test--wait (lambda () (eq (agent-session-status session) 'idle)))
           (setq remote (agent-emx--get session :emx-connection))
           (should (= ensures 2))
           (should (= forwards 1))
           (should (agent-emx--connection-ready remote))
           (setq local (gethash (cons nil (expand-file-name agent-emx-var-directory))
                                agent-emx--connections))
           (should (agent-emx--connection-ready local))
           (agent-session-backend-send 'emx session "ask remote")
           (agent-emx-remote-test--wait (lambda () (> (hash-table-count (agent-emx--table session :emx-asks)) 0)))
           (let ((cursor (copy-tree (agent-emx--get session :emx-cursor)))
                 (id (agent-emx--get session :emx-id)))
             (delete-process (agent-emx--connection-process remote))
             (agent-emx-remote-test--wait (lambda () (eq (agent-session-status session) 'disconnected)))
             (setq master "2")
             (agent-emx--ready session)
             (agent-emx-remote-test--wait (lambda () (and (agent-emx--connection-ready remote)
                                                          (not (agent-emx--get session :emx-attaching)))))
             (should (equal (agent-emx--get session :emx-id) id))
             (should (equal (agent-emx--get session :emx-cursor) cursor))
             (should (= forwards 2))
             (should (equal (plist-get (agent-emx--connection-remote remote) :master) "2"))
             (let ((ask (car (hash-table-keys (agent-emx--table session :emx-asks)))))
               (agent-emx--request remote "session/answer" (list :id id :ask ask :choice "allow")))
             (agent-emx-remote-test--wait (lambda () (string-match-p "allowed" (agent-emx-test--transcript session)))))
           ;; Real editor hub, two daemons; only the host transport is simulated.
           (agent-session-set-handle session "hub-target")
           (agent-session-send session "hub seed")
           (agent-emx-remote-test--wait (lambda () (eq (agent-session-status session) 'idle)))
           (setq local-view
                 (buffer-local-value
                  'agent-session--current
                  (agent-session-open 'test-emx agent-emx-var-directory)))
           (agent-emx-remote-test--wait (lambda () (eq (agent-session-status local-view) 'idle)))
           (agent-session-set-handle local-view "hub-source")
           (agent-session-send local-view "ask hold source")
           (agent-emx-remote-test--wait (lambda () (agent-session--pending-asks local-view)))
           (let* ((listed (agent-emx-test--mcp local local-view "tools/call" '(:name "sessions")))
                  (text (plist-get (aref (plist-get listed :content) 0) :text)))
             (should-not (plist-get listed :isError))
             (should (string-match-p "hub-target" text))
             (should (string-match-p "phase7" text))
             (let* ((data (json-parse-string text :object-type 'plist))
                    (target (seq-find (lambda (row) (equal (plist-get row :handle) "@hub-target"))
                                      (plist-get data :sessions))))
               (should (string-prefix-p "@hub-target#" (plist-get target :id)))))
           (let ((sent (agent-emx-test--mcp
                        local local-view "tools/call"
                        '(:name "session_ask" :arguments (:session "@hub-target" :prompt "hub question")))))
             (should-not (plist-get sent :isError)))
           (agent-emx-remote-test--wait
            (lambda () (string-match-p "echo: hub question" (agent-emx-test--transcript session))))
           (let ((read (agent-emx-test--mcp
                        local local-view "tools/call"
                        '(:name "session_read" :arguments (:session "@hub-target")))))
             (should-not (plist-get read :isError))
             (should (string-match-p "hub question"
                                     (plist-get (aref (plist-get read :content) 0) :text))))
           (agent-session--answer local-view (car (agent-session--pending-asks local-view)) 'allow)
           (agent-emx-remote-test--wait
            (lambda () (string-match-p "Reply from.*hub-target" (agent-emx-test--transcript local-view))))
           ;; Config-file calls make the remote -> Emacs -> local-daemon trip.
           (let ((path (concat "var/phase7-ert-" (number-to-string (emacs-pid)) ".el")) done result)
             (unwind-protect
                 (progn
                   (agent-emx-remote-config-call
                    remote (list :id "test-config" :params
                                 (list :method "config_write" :params
                                       (list :path path :content ";; phase7 fixture\n"))))
                   (agent-emx-remote-test--wait
                    (lambda () (file-exists-p (expand-file-name path agent-emx--checkout))))
                   (agent-emx--request local "config/call"
                                       (list :method "config_read" :arguments (list :path path))
                                       (lambda (r) (setq result r done t)))
                   (agent-emx-remote-test--wait (lambda () done))
                   (should (string-match-p "phase7 fixture" result)))
               (ignore-errors (delete-file (expand-file-name path agent-emx--checkout))))))
        (when (timerp agent-emx-remote--timer) (cancel-timer agent-emx-remote--timer))
        (when (and local-view (buffer-live-p (agent-session-buffer local-view)))
          (agent-session-kill-quietly (agent-session-buffer local-view)))
        (maphash (lambda (_ c)
                   (when (process-live-p (agent-emx--connection-process c))
                     (delete-process (agent-emx--connection-process c))))
                 agent-emx--connections)
        (let ((default-directory agent-emx--checkout)
              (process-environment (cons (concat "HOME=" agent-emx-remote-test--home) process-environment)))
          (ignore-errors
            (call-process "node" nil nil nil
                          (expand-file-name (concat ".cache/emacs-agent/emx/"
                                                    (plist-get (agent-emx-remote--manifest) :version)
                                                    ".current/bin/emx") agent-emx-remote-test--home)
                          "daemon" "--client" (agent-emx-remote-client-id) "--stop"))
          (ignore-errors
            (call-process "node" nil nil nil (expand-file-name "bin/emx" agent-emx--checkout)
                          "daemon" "--var" agent-emx-var-directory "--stop")))
        (delete-directory agent-emx-remote-test--home t)
        (delete-directory agent-emx-var-directory t)))))

(ert-deftest agent-emx-remote-test-ensure-output-with-warnings ()
  "Warnings a host's Node prints before the ensure result don't break it."
  (should (equal (plist-get (agent-emx-remote--json-line
                             (concat "(node:12) ExperimentalWarning: Type Stripping is an "
                                     "experimental feature\n{\"socket\":\"/s\",\"version\":\"v\"}\n"))
                            :socket)
                 "/s"))
  (should-error (agent-emx-remote--json-line "warning only\n")))

(ert-deftest agent-emx-remote-timer-only-forwards-remembered-socket ()
  (agent-emx-test--with-session
   (let* ((root "/rpc:phase7:/project/")
          (agent-emx--connections (make-hash-table :test #'equal))
          (agent-session--remote-programs (make-hash-table :test #'equal))
          (connection (agent-emx--make-connection
                       :place root :remote '(:remote "/host/emx.sock" :version "v1")))
          (default-directory root) forwarded connected)
     (setf (agent-session-root session) root
           (agent-session-status session) 'disconnected)
     (agent-emx--set session :emx-id "existing")
     (puthash root '(:node "v26.0.0") agent-session--remote-programs)
     (puthash (cons (file-remote-p root) (expand-file-name agent-emx-var-directory))
              connection agent-emx--connections)
     (puthash "existing" session (agent-emx--connection-sessions connection))
     (cl-letf (((symbol-function 'agent-emx--local-connection)
                (lambda (callback _error &rest _) (funcall callback nil)))
               ((symbol-function 'agent-session--host-connected-p) (lambda (_) t))
               ((symbol-function 'make-process)
                (lambda (&rest _) (should-not (file-remote-p default-directory))))
               ((symbol-function 'process-file)
                (lambda (&rest _) (should-not (file-remote-p default-directory)) 0))
               ((symbol-function 'copy-file)
                (lambda (&rest _) (ert-fail "Timer copied runtime")))
               ((symbol-function 'agent-emx-remote--manifest)
                (lambda () (ert-fail "Timer computed manifest")))
               ((symbol-function 'agent-emx-remote--forward)
                (lambda (_root socket _old only)
                  (should only) (should (equal socket "/host/emx.sock"))
                  (setq forwarded t) '(:socket "/local/emx.sock" :remote "/host/emx.sock")))
               ((symbol-function 'agent-emx--connect)
                (lambda (_ result)
                  (should (equal (plist-get result :socket) "/local/emx.sock"))
                  ;; hello needs it: a real host refused a versionless hello.
                  (should (equal (plist-get result :version) "v1"))
                  (setq connected t))))
       (agent-emx-remote--reconnect)
       (should forwarded) (should connected)))))

(ert-deftest agent-emx-remote-install-verifies-before-publishing ()
  (let* ((agent-emx-remote-test--home (make-temp-file "emx-stage-" t))
         (file-name-handler-alist (cons '("\\`/rpc:phase7:" . agent-emx-remote-test--handler)
                                       file-name-handler-alist))
         (manifest (agent-emx-remote--manifest))
         (copy (symbol-function 'copy-file)))
    (unwind-protect
        (cl-letf (((symbol-function 'copy-file)
                   (lambda (&rest args)
                     (apply copy args)
                     (with-temp-file (nth 1 args) (insert "truncated")))))
          (should-error (agent-emx-remote--install "/rpc:phase7:/project/" manifest))
          (should-not (file-exists-p
                       (expand-file-name (concat ".cache/emacs-agent/emx/"
                                                 (plist-get manifest :version) ".current/.complete")
                                         agent-emx-remote-test--home)))
          (should-not (directory-files
                       (expand-file-name ".cache/emacs-agent/emx" agent-emx-remote-test--home)
                       nil "stage-")))
      (delete-directory agent-emx-remote-test--home t))))

(ert-deftest agent-emx-remote-install-keeps-concurrent-publication ()
  (let* ((agent-emx-remote-test--home (make-temp-file "emx-race-" t))
         (file-name-handler-alist (cons '("\\`/rpc:phase7:" . agent-emx-remote-test--handler)
                                       file-name-handler-alist))
         (manifest (agent-emx-remote--manifest))
         (rename (symbol-function 'rename-file)) raced)
    (unwind-protect
        (cl-letf (((symbol-function 'rename-file)
                   (lambda (from to &optional overwrite)
                     (unless raced
                       (setq raced t)
                       (make-directory to)
                       (with-temp-file (concat to "/.complete")
                         (insert (plist-get manifest :version)))
                       (with-temp-file (concat to "/winner") (insert "other installer")))
                     (funcall rename from to overwrite))))
          (let ((dir (agent-emx-remote--install "/rpc:phase7:/project/" manifest)))
            (should raced)
            (should (file-exists-p (concat dir "winner")))
            (should-not (directory-files (file-name-directory (directory-file-name dir)) nil "stage-"))))
      (delete-directory agent-emx-remote-test--home t))))

(ert-deftest agent-emx-remote-ensure-surfaces-ordinary-errors ()
  (let ((connection (agent-emx--make-connection :place "/rpc:phase7:/project/"))
        (runs 0) (copies 0) failure)
    (cl-letf (((symbol-function 'agent-emx-remote--manifest) (lambda () '(:version "v")))
              ((symbol-function 'agent-emx-remote--process)
               (lambda (&rest _) (cl-incf runs) 1))
              ((symbol-function 'agent-emx-remote--install)
               (lambda (_root _manifest force) (should force) (cl-incf copies)))
              ((symbol-function 'agent-emx--lost) (lambda (_ error) (setq failure error))))
      (agent-emx-remote--ensure connection)
      (should failure) (should (= runs 1)) (should (= copies 0)))))

(ert-deftest agent-emx-remote-images-upload-before-send-and-steer ()
  (agent-emx-test--with-session
   (setf (agent-session-root session) "/rpc:phase7:/project/")
   (let (uploads sent)
     (cl-letf (((symbol-function 'agent-remote-upload)
                (lambda (root file)
                  (should (equal root "/rpc:phase7:/project/"))
                  (push file uploads) "/host/uploads/paste.png"))
               ((symbol-function 'agent-emx--rpc)
                (lambda (_ method params &rest _)
                  (should uploads)
                  (push (cons method params) sent))))
       (dolist (method '(agent-session-backend-send agent-session-backend-steer))
         (funcall method 'emx session (concat "image " (propertize "[image]" 'agent-session-image "/local/paste.png"))))
       (should (= (length uploads) 2))
       (dolist (entry sent)
         (should (equal (plist-get (cdr entry) :images) ["/host/uploads/paste.png"])))))))

(ert-deftest agent-emx-remote-tilde-root-expands-before-open ()
  (agent-emx-test--with-session
   (let* ((agent-emx-remote-test--home (make-temp-file "emx-tilde-" t))
          (file-name-handler-alist (cons '("\\`/rpc:phase7:" . agent-emx-remote-test--handler)
                                        file-name-handler-alist))
          (connection (agent-emx--make-connection :place "/rpc:phase7:~/project/"))
          opened)
     (setf (agent-session-root session) "/rpc:phase7:~/project/")
     (agent-emx--set session :emx-id nil)
     (cl-letf (((symbol-function 'agent-emx--connection)
                (lambda (_ callback _error) (funcall callback connection)))
               ((symbol-function 'agent-emx--request)
                (lambda (_ method params &rest _)
                  (when (equal method "session/open") (setq opened params)))))
       (unwind-protect
           (progn
             (agent-emx--ready session)
             (should (equal (plist-get opened :root)
                            (concat agent-emx-remote-test--home "/project/")))
             (should (equal (agent-emx-remote-result
                             connection (agent-emx-remote-path connection "/absolute/file"))
                            "/absolute/file")))
         (delete-directory agent-emx-remote-test--home t))))))

(ert-deftest agent-emx-remote-skills-copy-before-hello-callback ()
  (agent-emx-test--with-session
   (let ((connection (agent-emx--make-connection :place "/rpc:phase7:/project/"))
         callback async copied opened)
     (setf (agent-session-agent session) 'codex
           (agent-session-root session) "/rpc:phase7:/project/")
     (agent-emx--set session :emx-id nil)
     (cl-letf (((symbol-function 'agent-session-skills-dir)
                (lambda (_) (should-not async) (setq copied t) "/host/skills"))
               ((symbol-function 'agent-emx--connection)
                (lambda (_ receive _error) (setq callback receive)))
               ((symbol-function 'agent-emx--request)
                (lambda (_ method params &rest _)
                  (when (equal method "session/open") (setq opened params)))))
       (agent-emx--ready session)
       (should copied)
       (setq async t)
       (funcall callback connection)
       (should (equal (plist-get (plist-get opened :skills) :skillsDir) "/host/skills"))))))

(ert-deftest agent-emx-remote-timer-never-opens-new-sessions ()
  (agent-emx-test--with-session
   (let ((agent-emx--connections (make-hash-table :test #'equal))
         (connection (agent-emx--make-connection :place "/rpc:phase7:/project/")) tried)
     (setf (agent-session-status session) 'disconnected)
     (agent-emx--set session :emx-id nil)
     (puthash "pending" session (agent-emx--connection-sessions connection))
     (puthash "host" connection agent-emx--connections)
     (cl-letf (((symbol-function 'agent-session--host-connected-p) (lambda (_) t))
               ((symbol-function 'agent-emx--ready)
                (lambda (_) (setq tried t))))
       (agent-emx-remote--reconnect)
       (should-not tried)))))

(ert-deftest agent-emx-remote-silent-hello-stays-disconnected ()
  (let ((connection (agent-emx--make-connection)) failure)
    (cl-letf (((symbol-function 'agent-emx--lost)
               (lambda (_ error &rest _) (setq failure error))))
      (agent-emx-remote--hello-expired connection nil)
      (should (equal (plist-get failure :message) "Host daemon did not answer"))
      (setq failure nil)
      (setf (agent-emx--connection-ready connection) t)
      (agent-emx-remote--hello-expired connection nil)
      (should-not failure))))

(ert-deftest agent-emx-remote-bootstrap-outside-project-direnv ()
  (let ((root "/rpc:phase7:/project/"))
    (cl-letf (((symbol-function 'process-file)
               (lambda (&rest _)
                 (should (equal default-directory "/rpc:phase7:~/")) 0)))
      (should (= (agent-emx-remote--process root '("sh" "-c" "true") nil) 0)))))

(ert-deftest agent-emx-remote-repair-keeps-published-files ()
  (let* ((agent-emx-remote-test--home (make-temp-file "emx-repair-" t))
         (file-name-handler-alist (cons '("\\`/rpc:phase7:" . agent-emx-remote-test--handler)
                                        file-name-handler-alist))
         (manifest (agent-emx-remote--manifest))
         (root "/rpc:phase7:/project/"))
    (unwind-protect
        (let ((original (agent-emx-remote--install root manifest)))
          (with-temp-file (concat original "in-use") (insert "live daemon"))
          (let ((fresh (agent-emx-remote--install root manifest t)))
            (should-not (equal original fresh))
            (should (file-exists-p (concat original "in-use")))
            (should (file-exists-p (concat fresh "bin/emx")))
            (should (equal (file-truename fresh)
                           (file-truename (concat original "../"
                                                  (plist-get manifest :version) ".current/"))))))
      (delete-directory agent-emx-remote-test--home t))))

(ert-deftest agent-emx-remote-bootstrap-classifies-missing-corrupt-and-node ()
  (let* ((home (make-temp-file "emx-bootstrap-" t))
         (default-directory home)
         (process-environment (cons (concat "HOME=" home) process-environment))
         (manifest '(:version "test" :integrity [(:file "bin/emx" :size 1 :sha256 "bad")]))
         (command (agent-emx-remote--bootstrap "runtime" manifest)))
    (unwind-protect
        (with-temp-buffer
          (should (= (apply #'call-process (car command) nil t nil (cdr command)) 44))
          (make-directory (expand-file-name "runtime" home))
          (make-symbolic-link "runtime" (expand-file-name "runtime.current" home))
          (with-temp-file (expand-file-name "runtime/.complete" home) (insert "test"))
          (should (= (apply #'call-process (car command) nil t nil (cdr command)) 45))
          ;; An unreadable file is not proof of corruption and must not repair.
          (make-directory (expand-file-name "runtime/bin" home))
          (with-temp-file (expand-file-name "runtime/bin/emx" home) (insert "x"))
          (set-file-modes (expand-file-name "runtime/bin/emx" home) #o000)
          (erase-buffer)
          (should (= (apply #'call-process (car command) nil t nil (cdr command)) 1))
          (should (string-match-p "EACCES" (buffer-string)))
          (set-file-modes (expand-file-name "runtime/bin/emx" home) #o600)
          ;; The bootstrap Node is checked even before inspecting the install.
          (make-directory (expand-file-name "bin" home))
          (with-temp-file (expand-file-name "old-node.cjs" home)
            (insert "Object.defineProperty(process.versions,'node',{value:'16.0.0'});"))
          (with-temp-file (expand-file-name "bin/node" home)
            (insert "#!/bin/sh\nexec " (shell-quote-argument (executable-find "node"))
                    " --require " (shell-quote-argument (expand-file-name "old-node.cjs" home))
                    " \"$@\"\n"))
          (set-file-modes (expand-file-name "bin/node" home) #o700)
          (let ((process-environment (cons (concat "PATH=" (expand-file-name "bin" home)
                                                   ":" (getenv "PATH")) process-environment)))
            (erase-buffer)
            (should (= (apply #'call-process (car command) nil t nil (cdr command)) 46))
            (should (string-match-p "got v" (buffer-string)))))
      (delete-directory home t))))

(ert-deftest agent-emx-remote-queues-during-local-startup ()
  (let ((agent-emx--connections (make-hash-table :test #'equal))
        (agent-emx-remote--timer t) (runs 0) (failures 0) local-failure)
    (cl-letf (((symbol-function 'agent-emx-remote--manifest) (lambda () '(:version "v")))
              ((symbol-function 'agent-emx-remote--process)
               (lambda (_root _command buffer)
                 (cl-incf runs)
                 (with-current-buffer buffer (insert "{\"version\":\"v\",\"socket\":\"/remote\"}\n")) 0))
              ((symbol-function 'agent-emx-remote--forward)
               (lambda (&rest _) '(:socket "/local")))
              ((symbol-function 'agent-emx--local-connection)
               (lambda (_callback failure &rest _) (setq local-failure failure)))
              ((symbol-function 'run-at-time) (lambda (&rest _) nil)))
      (let* ((error-callback (lambda (_) (cl-incf failures)))
             (connection (agent-emx-remote-connection "/rpc:phase7:/project/" #'ignore error-callback)))
        (agent-emx-remote-connection "/rpc:phase7:/other/" #'ignore error-callback)
        (should (= runs 1))
        (should (= (length (agent-emx--connection-waiters connection)) 2))
        (funcall local-failure '(:message "local startup failed"))
        (should (= failures 2))
        (agent-emx-remote-connection "/rpc:phase7:/project/" #'ignore error-callback)
        (should (= runs 2))))))

