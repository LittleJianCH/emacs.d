;;; agent-emx-config-test.el --- Effective daemon config tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'agent-collab)
(require 'agent-emx)
(defconst agent-emx-config-test--file
  (expand-file-name "../emx/config.json" (file-name-directory (or load-file-name buffer-file-name))))
(defun agent-emx-config-test--read ()
  (with-temp-buffer
    (insert-file-contents agent-emx-config-test--file)
    (json-parse-buffer :object-type 'plist :false-object :false)))
(ert-deftest agent-emx-config-defaults-preserve-lisp-definitions ()
  (let* ((agent-emx-config--value nil)
         (before (agent-ui--describe nil))
         (profiles agent-collab-profiles))
    (agent-emx-config-receive (agent-emx-config-test--read))
    (should (equal profiles (agent-emx-config-profiles nil)))
    (should (equal (json-serialize before)
                   (json-serialize (agent-ui--describe nil))))
    (should (equal agent-collab-start-guidance
                   (agent-collab--option :startGuidance nil)))
    (should (equal (agent-collab--task-note
                    (agent-session--make :agent 'claude :info '(:handle "topic")) nil)
                   "(From the Claude agent of session \"@topic\", which started this session with session_start.  Your final reply goes back to it.  You can't start sessions yourself.)"))))
(ert-deftest agent-emx-config-cache-refresh-and-fallback ()
  (let ((agent-emx-config--value nil) (agent-collab-max-active 7))
    (should (= (agent-collab--option :maxActive agent-collab-max-active) 7))
    (agent-emx-config-receive '(:collab (:maxActive 2 :confirm :false)))
    (should (= (agent-collab--option :maxActive agent-collab-max-active) 2))
    (should-not (agent-collab--option :confirm t))
    (agent-emx--dispatch (agent-emx--make-connection)
                         '(:method "config" :params (:config (:collab (:maxActive 3)))))
    (should (= (agent-collab--option :maxActive nil) 3))))
(provide 'agent-emx-config-test)

(ert-deftest agent-emx-config-applies-launch-policy-to-lisp-backends ()
  (let ((agent-emx-config--value nil)
        (agent-codex-executable "offline")
        (agent-codex-extra-args nil)
        (agent-codex-native-subagents t)
        (agent-session-agents '((codex :title "Codex" :executable agent-codex-executable))))
    (agent-emx-config-receive
     '(:agents (:codex (:title "Configured" :executable "/private/tmp/fake-codex"
                        :extraArgs ["-c" "literal=value"] :nativeSubagents :false))))
    (should (equal agent-codex-executable "/private/tmp/fake-codex"))
    (should (equal agent-codex-extra-args '("-c" "literal=value")))
    (should-not agent-codex-native-subagents)
    (should (eq (agent-session--get 'codex :executable) 'agent-codex-executable))
    (should (equal (agent-session--program 'codex) agent-codex-executable))
    (should (equal (agent-session--get 'codex :title) "Configured"))))
