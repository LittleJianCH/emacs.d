{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "lib": [
      "es2024"
    ],
    "rootDir": ".."
  },
  "include": [
    "**/*.ts",
    "../test/emx/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".dist-*"
  ]
}
