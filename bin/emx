#!/usr/bin/env node
// emx — bridge for agents to operate Emacs (command line + MCP server).
//
//   emx help [method]                list all methods / show a method's full description
//   emx <method> [positional args] [--key value ...]
//   emx render page.json             native page from JSON {title, blocks} (- = stdin)
//   emx open src/main.rs 42          open a file and jump to line 42
//   emx show report.org              show org / markdown / diff etc. content
//   echo '* Title' | emx show - --format org   read the content from stdin
//   emx context                      the user's current file, cursor, selection
//   emx eval '(buffer-list)'         evaluate arbitrary Elisp
//   emx mcp                          run as a stdio MCP server
//
// Methods are defined in lisp/agent/agent-ui.el; extend them with agent-ui-defmethod.
// The config_* methods are emx's own (see "Config files" below).
// Environment: EMACS_SOCKET_NAME selects the server (set automatically inside agent
//              sessions), EMX_EMACSCLIENT sets the emacsclient path, EMX_REMOTE_AGENT=1
//              (set for agents of remote projects) enables the config_* methods.

'use strict';
const { execFileSync } = require('node:child_process');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const readline = require('node:readline');

const EMACSCLIENT = process.env.EMX_EMACSCLIENT || 'emacsclient';
const VERSION = '0.1.0';
// The Emacs configuration checkout this emx belongs to.
const CONFIG_DIR = path.resolve(__dirname, '..');
const REMOTE_AGENT = process.env.EMX_REMOTE_AGENT === '1';

// Maps positional arguments to parameter names; other parameters use --key value.
const POSITIONAL = {
  open: ['path', 'line', 'end_line'],
  show: ['path'],
  eval: ['code'],
  notify: ['message'],
  read_buffer: ['name', 'start_line', 'end_line'],
  diagnostics: ['path'],
  session_read: ['session', 'last'],
  session_ask: ['prompt'],
  config_read: ['path', 'offset', 'limit'],
};

// These methods take structured data: the positional argument is a JSON file (or - for
// stdin) whose contents are merged into the parameters.
const JSON_INPUT = new Set(['render', 'patch']);

const lispString = (s) => '"' + s.replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"';

// Call an agent-ui method in Emacs; return its response {ok, result | pending} or throw
// an error.
function request(method, params = {}) {
  params = { ...params };
  if (typeof params.path === 'string') params.path = path.resolve(params.path);

  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'emx-'));
  const request = path.join(dir, 'request.json');
  const response = path.join(dir, 'response.json');
  try {
    // Tell Emacs which agent session is calling, so page buttons etc. can send
    // messages back to that session.
    const context = { agent_buffer: process.env.EMX_AGENT_BUFFER || null };
    fs.writeFileSync(request, JSON.stringify({ method, params, context }));
    try {
      execFileSync(EMACSCLIENT,
        ['--eval', `(agent-ui-rpc ${lispString(request)} ${lispString(response)})`],
        { stdio: ['ignore', 'ignore', 'pipe'], timeout: 30000 });
    } catch (err) {
      const detail = (err.stderr && err.stderr.toString().trim()) || err.message;
      throw new Error(`Cannot reach Emacs (is Emacs running with a server started?): ${detail}`);
    }
    const out = JSON.parse(fs.readFileSync(response, 'utf8'));
    if (!out.ok) throw new Error(out.error);
    return out;
  } finally {
    fs.rmSync(dir, { recursive: true, force: true });
  }
}

// Call an agent-ui method that answers at once; return the result or throw an error.
function call(method, params = {}) {
  const out = request(method, params);
  if (out.pending) {
    request('_poll', { id: out.pending, cancel: true });
    throw new Error(`${method} waits for its result; call it through the MCP server or the command line`);
  }
  return out.result;
}

const POLL_INTERVAL = 1000;
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

// Call an agent-ui method and wait for its result. A method that would block Emacs
// while it waits (e.g. for another agent) answers {pending: id} at once;
// poll it until it is done. Setting signal.cancelled gives it up.
async function callAsync(method, params = {}, signal = {}) {
  let out = request(method, params);
  while (out.pending) {
    await sleep(POLL_INTERVAL);
    if (signal.cancelled) {
      request('_poll', { id: out.pending, cancel: true });
      throw new Error('Cancelled');
    }
    out = request('_poll', { id: out.pending });
  }
  return out.result;
}

const render = (result) =>
  typeof result === 'string' ? result : JSON.stringify(result, null, 2);

// ---------------------------------------------------------------- Config files
//
// The file tools of a remote project's agent work on the project's host and can't
// reach this machine. These methods let it read and edit the Emacs configuration here.
// They run in emx rather than Emacs, so file I/O never blocks the editor; Emacs is only
// asked about buffers visiting a file before and after it is written. Paths are
// confined to the configuration checkout, outside .git, against slips such as editing
// the wrong host's files. That is a guardrail, not a sandbox: eval stays unrestricted.

function exists(file) {
  try {
    fs.lstatSync(file);
    return true;
  } catch {
    return false;
  }
}

// Resolve FILE (relative to the configuration, absolute, or ~/...) to a real path in it.
function configPath(file) {
  if (typeof file !== 'string' || !file) throw new Error('path is required');
  if (file === '~' || file.startsWith('~/')) file = path.join(os.homedir(), file.slice(1));
  const root = fs.realpathSync(CONFIG_DIR);
  // Resolve symlinks through the deepest existing ancestor, so none leads outside.
  let real = path.resolve(root, file);
  const rest = [];
  while (!exists(real)) {
    rest.unshift(path.basename(real));
    real = path.dirname(real);
  }
  real = path.join(fs.realpathSync(real), ...rest);
  const rel = path.relative(root, real);
  if (!rel || rel === '..' || rel.startsWith('..' + path.sep) || path.isAbsolute(rel) ||
      rel.split(path.sep)[0] === '.git') {
    throw new Error(`${file} is not a file in the Emacs configuration (${root})`);
  }
  return real;
}

// Refuse to overwrite unsaved edits in a buffer visiting FILE.
function checkBuffer(file) {
  if (call('eval', { code: `(agent-ui-file-modified-p ${lispString(file)})` }) !== 'nil') {
    throw new Error(`${file} has unsaved changes in Emacs; ask the user to save or revert it first`);
  }
}

// Write CONTENT to FILE, then let Emacs refresh a buffer visiting it.
function writeConfigFile(file, content) {
  checkBuffer(file);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, content);
  try {
    call('eval', { code: `(agent-ui-file-written ${lispString(file)})` });
  } catch {
    // The file is written; a stale buffer is all that is left.
  }
}

// What to tell the agent after writing FILE: Emacs still runs the old Lisp.
const reloadHint = (file) =>
  file.endsWith('.el')
    ? '. The running Emacs still has the old version: call reload once your edits are done.'
    : '';

const PATH_PARAM = {
  type: 'string',
  description: 'File path, relative to the Emacs configuration root or absolute inside it',
};

const CONFIG_METHODS = {
  config_read: {
    description: `Read a file of the Emacs configuration on the machine Emacs runs on, with
line numbers. Use it instead of your own file tools, which work on the project's host.`,
    inputSchema: {
      type: 'object',
      properties: {
        path: PATH_PARAM,
        offset: { type: 'integer', description: 'First line to read, default 1' },
        limit: { type: 'integer', description: 'Number of lines to read, default 2000' },
      },
      required: ['path'],
    },
    run({ path: file, offset, limit }) {
      const lines = fs.readFileSync(configPath(file), 'utf8').split('\n');
      if (lines[lines.length - 1] === '') lines.pop();
      if (!lines.length) return '(empty file)';
      const start = Math.max(1, Number(offset) || 1);
      const count = Math.max(1, Number(limit) || 2000);
      const out = lines.slice(start - 1, start - 1 + count)
        .map((line, i) => `${String(start + i).padStart(6)}\t${line}`);
      if (start - 1 + count < lines.length) {
        out.push(`... ${lines.length} lines in total; continue with offset ${start + count}`);
      }
      return out.join('\n');
    },
  },
  config_edit: {
    description: `Replace an exact string in a file of the Emacs configuration on the
machine Emacs runs on. old_string must occur exactly once unless replace_all is set.
Fails if a buffer visiting the file has unsaved changes; a visiting buffer without
changes is reverted afterwards.`,
    inputSchema: {
      type: 'object',
      properties: {
        path: PATH_PARAM,
        old_string: { type: 'string', description: 'Text to replace, including whitespace' },
        new_string: { type: 'string', description: 'Replacement text' },
        replace_all: { type: 'boolean', description: 'Replace every occurrence' },
      },
      required: ['path', 'old_string', 'new_string'],
    },
    run({ path: file, old_string: from, new_string: to, replace_all: all }) {
      if (typeof from !== 'string' || !from) throw new Error('old_string is required');
      if (typeof to !== 'string') throw new Error('new_string is required');
      if (from === to) throw new Error('old_string and new_string are the same');
      const real = configPath(file);
      const parts = fs.readFileSync(real, 'utf8').split(from);
      const count = parts.length - 1;
      if (!count) throw new Error(`old_string not found in ${real}`);
      if (count > 1 && all !== true && all !== 'true') {
        throw new Error(`old_string occurs ${count} times in ${real}; add context to make it unique, or set replace_all`);
      }
      writeConfigFile(real, parts.join(to));
      return `Edited ${real} (${count} ${count === 1 ? 'replacement' : 'replacements'})${reloadHint(real)}`;
    },
  },
  config_write: {
    description: `Create or overwrite a file of the Emacs configuration on the machine
Emacs runs on. Prefer config_edit for changes to existing files. Fails if a buffer
visiting the file has unsaved changes; a visiting buffer without changes is reverted
afterwards.`,
    inputSchema: {
      type: 'object',
      properties: {
        path: PATH_PARAM,
        content: { type: 'string', description: 'The complete file content' },
      },
      required: ['path', 'content'],
    },
    run({ path: file, content }) {
      if (typeof content !== 'string') throw new Error('content is required');
      const real = configPath(file);
      writeConfigFile(real, content);
      return `Wrote ${real}${reloadHint(real)}`;
    },
  },
};

// Methods for this emx: the configuration methods only serve agents of remote projects,
// local ones have their own file tools.
const configMethods = () => (REMOTE_AGENT ? CONFIG_METHODS : {});

async function invoke(method, params, signal) {
  const local = configMethods();
  return Object.hasOwn(local, method) ? local[method].run(params) : callAsync(method, params, signal);
}

const configTools = () =>
  Object.entries(configMethods()).map(([name, m]) =>
    ({ name, description: m.description, inputSchema: m.inputSchema }));

// ---------------------------------------------------------------- Command line

function parseArgs(method, argv) {
  const params = {};
  const positional = [];
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg.startsWith('--') && arg.length > 2) {
      const [key, inline] = arg.slice(2).split(/=(.*)/s);
      params[key.replace(/-/g, '_')] = inline !== undefined ? inline : argv[++i];
    } else {
      positional.push(arg);
    }
  }
  if (JSON_INPUT.has(method) && positional.length) {
    const source = positional[0] === '-' ? 0 : positional[0];
    return { ...JSON.parse(fs.readFileSync(source, 'utf8')), ...params };
  }
  (POSITIONAL[method] || []).forEach((key, i) => {
    if (positional[i] !== undefined && params[key] === undefined) params[key] = positional[i];
  });
  // "-" means read the content from stdin.
  if (params.path === '-') {
    delete params.path;
    params.content = fs.readFileSync(0, 'utf8');
  }
  return params;
}

function help(name) {
  const methods = [...call('describe'), ...configTools()];
  if (name) {
    const m = methods.find((m) => m.name === name);
    if (!m) throw new Error(`Unknown method: ${name}`);
    return `${m.name}\n\n${m.description}\n\nParameters: ${JSON.stringify(m.inputSchema.properties, null, 2)}`;
  }
  const lines = ['Usage: emx <method> [positional args] [--key value ...]', ''];
  for (const m of methods) {
    lines.push(`${m.name}  ${m.description.split('\n')[0]}`);
    const required = new Set(m.inputSchema.required);
    for (const [key, prop] of Object.entries(m.inputSchema.properties)) {
      lines.push(`    --${key} <${prop.type}>${required.has(key) ? ' (required)' : ''}  ${prop.description}`);
    }
  }
  lines.push('', 'emx help <method>  Show the full description of a method',
             'emx mcp            Run as a stdio MCP server');
  return lines.join('\n');
}

// ---------------------------------------------------------------- MCP

const MCP_INSTRUCTIONS = `These tools operate the Emacs instance the user is working in (your session is hosted inside it).
- To present formatted content (option comparisons, plans, review results, architecture
  diagrams, charts, progress), use render to build a native page; it is far clearer than
  long markdown in the chat. Pages can contain buttons whose prompts are sent back to your
  session when the user clicks them. Use patch to update parts of a page afterwards.
- To point the user at code, use open to show and highlight it instead of only citing a path.
- Use show to display an existing org / markdown document or a diff.
- For an atomic review of a branch (原子审查 / atomic review), call review_snapshot and
  follow its description; read the user's annotations with review_comments and answer
  them with review_reply.
- Call context first to see which file, cursor position and selection the user is looking at.
- For editor operations the other tools do not cover, run Elisp with eval.
- Other agent sessions (Claude, Codex) may run in this Emacs. Each has an @handle, and the
  user mentions sessions with it. sessions lists them, session_read reads their latest
  turns, and session_ask asks another agent (a second opinion, a review of your changes)
  and waits for its reply.
- After editing the Lisp files of this Emacs configuration, apply them with reload rather
  than loading them through eval.
- The user reads Chinese: write page content and notifications in Chinese unless asked otherwise.`;

const REMOTE_INSTRUCTIONS = `
- Your own file tools work on the project's host, not on the machine Emacs runs on. To
  work on this Emacs configuration (${CONFIG_DIR}), use config_read, config_edit and
  config_write; read its AGENTS.md first. Edits take effect after reload.`;

function mcpServer() {
  const send = (msg) => process.stdout.write(JSON.stringify(msg) + '\n');
  const reply = (id, result) => send({ jsonrpc: '2.0', id, result });
  const fail = (id, code, message) => send({ jsonrpc: '2.0', id, error: { code, message } });

  const handlers = {
    initialize: (params) => ({
      protocolVersion: (params && params.protocolVersion) || '2025-06-18',
      capabilities: { tools: { listChanged: false } },
      serverInfo: { name: 'emacs', version: VERSION },
      instructions: MCP_INSTRUCTIONS + (REMOTE_AGENT ? REMOTE_INSTRUCTIONS : ''),
    }),
    ping: () => ({}),
    'tools/list': () => {
      try {
        return { tools: [...call('describe'), ...configTools()] };
      } catch (err) {
        process.stderr.write(`emx: ${err.message}\n`);
        return { tools: configTools() };
      }
    },
    'tools/call': async ({ name, arguments: args }, id) => {
      const signal = {};
      running.set(id, signal);
      try {
        return { content: [{ type: 'text', text: render(await invoke(name, args || {}, signal)) }] };
      } catch (err) {
        return { content: [{ type: 'text', text: err.message }], isError: true };
      } finally {
        running.delete(id);
      }
    },
  };
  // Calls still waiting for their result, by request id, so they can be cancelled.
  const running = new Map();

  const rl = readline.createInterface({ input: process.stdin });
  rl.on('line', (line) => {
    if (!line.trim()) return;
    let msg;
    try {
      msg = JSON.parse(line);
    } catch {
      return fail(null, -32700, 'Parse error');
    }
    if (msg.id === undefined) {
      // Notifications need no reply; a cancelled call stops waiting.
      if (msg.method === 'notifications/cancelled') {
        const signal = running.get(msg.params && msg.params.requestId);
        if (signal) signal.cancelled = true;
      }
      return;
    }
    const handler = handlers[msg.method];
    if (!handler) return fail(msg.id, -32601, `Method not found: ${msg.method}`);
    // Handlers may be async: replies can go out in another order than the requests.
    Promise.resolve()
      .then(() => handler(msg.params || {}, msg.id))
      .then((result) => reply(msg.id, result), (err) => fail(msg.id, -32603, err.message));
  });
}

// ---------------------------------------------------------------- Entry point

async function main() {
  const [method, ...rest] = process.argv.slice(2);
  if (method === 'mcp') return mcpServer();
  if (!method || method === 'help' || method === '-h' || method === '--help') {
    console.log(help(rest[0]));
    return;
  }
  console.log(render(await invoke(method, parseArgs(method, rest))));
}

main().catch((err) => {
  console.error(`emx: ${err.message}`);
  process.exit(1);
});
